    {
      "@id": "https://openpix.dev/knowledge/article-sdui-003",
      "@type": [
        "schema:TechArticle"
      ],
      "title": "Compatibilidade SDUI — prevenção no backend, reação no cliente",
      "status": "draft",
      "boundedContext": "https://openpix.dev/knowledge/ctx-sdui",
      "created": "2026-07-30",
      "updated": "2026-07-30",
      "tags": [
        "article",
        "compatibility",
        "construindo-o-pix",
        "fastapi",
